{
  "name": "@talos-ark/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0",
  "author": "Maiturin",
  "description": "璇玑云库 - 后端服务",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "db:gen-client": "prisma generate",
    "db:studio": "prisma studio -b none",
    "db:pull": "prisma db pull",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "build": "nest build && tsc-alias -v",
    "start:dev": "dotenvx run -f secrets/env/.env.development -- nest start --watch --exec \"pnpm tsc-alias -v && node dist/src/main.js\"",
    "start:prod": "pnpm build && dotenvx run -f secrets/env/.env.production -- node dist/src/main.js",
    "test": "dotenvx run -f secrets/env/.env.test -- vitest run",
    "test:coverage": "dotenvx run -f secrets/env/.env.test -- vitest run --coverage",
    "test:watch": "dotenvx run -f secrets/env/.env.test -- vitest",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "env:encrypt": "dotenvx encrypt -f secrets/env/.env.development secrets/env/.env.test secrets/env/.env.production",
    "env:decrypt": "dotenvx decrypt -f secrets/env/.env.development secrets/env/.env.test secrets/env/.env.production",
    "docs:gen-reference": "tsx scripts/generate-error-reference.ts",
    "docs:gen-openapi": "dotenvx run -f secrets/env/.env.development -- tsx scripts/generate-openapi.ts",
    "docs:dev": "pnpm docs:gen-reference && dotenvx run -f secrets/env/.env.development -- pnpm --filter @talos-ark/docsite dev",
    "docs:build": "pnpm docs:gen-reference && pnpm --filter @talos-ark/docsite build",
    "docs:serve": "pnpm --filter @talos-ark/docsite serve",
    "prisma": "tsx scripts/prisma.ts",
    "dotenvx": "dotenvx"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1053.0",
    "@aws-sdk/lib-storage": "^3.1053.0",
    "@aws-sdk/s3-request-presigner": "^3.1053.0",
    "@dotenvx/dotenvx-ops": "^0.48.3",
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^10.0.0",
    "@fastify/static": "^9.1.3",
    "@keyv/valkey": "^1.0.11",
    "@nestjs/cache-manager": "^3.1.2",
    "@nestjs/common": "^11.1.24",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.24",
    "@nestjs/platform-fastify": "^11.1.24",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@scalar/nestjs-api-reference": "^1.1.19",
    "bcryptjs": "^3.0.3",
    "cache-manager": "^7.2.8",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "fastify": "^5.8.5",
    "figlet": "^1.11.0",
    "gradient-string": "^3.0.0",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.18.1",
    "nestjs-pino": "^4.6.1",
    "nestjs-zod": "^5.4.0",
    "nodemailer": "^8.0.8",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ulid": "^3.0.2",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.21",
    "@nestjs/testing": "^11.1.24",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.24",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.9.1",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.7",
    "prisma": "^7.8.0",
    "supertest": "^7.2.2",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.7"
  }
}
