# ===== 文档站镜像 - Production =====
FROM node:22.22-slim AS builder
RUN apt-get update && apt-get install -y git --no-install-recommends && rm -rf /var/lib/apt/lists/*
RUN npm install -g pnpm

WORKDIR /app

# 安装 workspace 级别依赖（利用 layer cache）
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY biological-storage-box-docs/package.json ./biological-storage-box-docs/
COPY biological-storage-box-service/package.json ./biological-storage-box-service/

RUN echo 'shamefully-hoist=true' >> .npmrc && pnpm install --frozen-lockfile --ignore-scripts

# 复制文档内容和构建脚本
COPY biological-storage-box-service/tsconfig.json ./biological-storage-box-service/
COPY biological-storage-box-service/CHANGELOG.md ./biological-storage-box-service/
COPY .git ./.git
COPY biological-storage-box-service/src ./biological-storage-box-service/src
COPY biological-storage-box-service/docs ./biological-storage-box-service/docs
COPY biological-storage-box-service/scripts ./biological-storage-box-service/scripts
COPY biological-storage-box-docs ./biological-storage-box-docs

# 生成错误码参考文档 + 构建 VitePress
# /reference/ 指向同镜像内 nginx 静态 Scalar 页（nginx.conf location /reference/）
ARG VITE_API_REFERENCE_URL=/api-reference/
ENV VITE_API_REFERENCE_URL=$VITE_API_REFERENCE_URL

# VitePress 基础路径，域名路由时就是根路径
ARG VITE_BASE_PATH=/
ENV VITE_BASE_PATH=$VITE_BASE_PATH

RUN pnpm --filter biological-storage-box-service docs:build

# ===== 阶段2：运行 nginx（非 root）=====
# 使用 nginxinc/nginx-unprivileged 官方维护的便捷镜像，开筱即用非 root 运行
FROM nginxinc/nginx-unprivileged:alpine AS runner

# VitePress 产物（含 reference/index.html）
COPY --from=builder /app/biological-storage-box-docs/dist /usr/share/nginx/html

# Scalar API Reference 页
COPY --from=builder /app/biological-storage-box-docs/api-reference/index.html /usr/share/nginx/html/api-reference/index.html

# openapi.json（本地构建前先运行 pnpm docs:gen-openapi；CI 通过 --build-arg 覆盖路径）
ARG OPENAPI_JSON_PATH=biological-storage-box-docs/api-reference/openapi.json
COPY ${OPENAPI_JSON_PATH} /usr/share/nginx/html/reference/api/openapi.json

# nginx 配置
COPY biological-storage-box-docs/nginx.prod.conf /etc/nginx/conf.d/default.conf

EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=5s --start-period=10s --retries=5 \
    CMD wget -qO- http://127.0.0.1:8080/ || exit 1
