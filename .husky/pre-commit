#!/bin/sh

GREEN="\033[32m"; YELLOW="\033[33m"; RESET="\033[0m"

log()  { printf "%-12b  %b\n" "${GREEN}[GitHook]" "[LOG] $1${RESET}"; }
warn() { printf "%-12b  %b\n" "${YELLOW}[GitHook]" "[WARN] $1${RESET}"; }

log "\n执行 Pre-commit hook..."

# 加密 backend env 文件
backend_envs=$(git diff --cached --name-only -- 'apps/backend/**/.env.*' ':!apps/backend/**/.env.example' | sed 's|^apps/backend/||' || true)

if [ -n "$backend_envs" ]; then
    log "加密 backend env 文件..."
    backend_args=""
    for f in $backend_envs; do backend_args="$backend_args -f $f"; done
    (cd apps/backend && pnpm exec dotenvx encrypt $backend_args)
    git add $(echo "$backend_envs" | sed 's|^|apps/backend/|')
fi

if git diff --cached --quiet; then
    warn "无暂存文件，跳出 Pre-commit hooks"
    exit 0
fi

pnpm lint-staged

# 按工作区分别触发测试
staged_backend=$(git diff --cached --name-only | grep -E '^apps/backend/.*\.(js|ts|d\.ts)$' || true)
staged_frontend=$(git diff --cached --name-only | grep -E '^apps/frontend/.*\.(js|ts|d\.ts|vue)$' || true)

if [ -n "$staged_backend" ]; then
    log "运行 backend 测试"
    pnpm --filter @talos-ark/backend test
else
    log "跳过 backend 测试"
fi

if [ -n "$staged_frontend" ]; then
    log "运行 frontend 测试"
    pnpm --filter @talos-ark/frontend test
else
    log "跳过 frontend 测试"
fi

log "Pre-commit hooks 执行完毕"
exit 0
