{
  "name": "biological-storage-box-service",
  "private": true,
  "version": "0.7.4",
  "description": "生物样本储存管理系统 — 后端服务",
  "license": "MIT",
  "type": "module",
  "keywords": [],
  "author": "Maiturin",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "db:gen-client": "prisma generate",
    "db:studio": "prisma studio -b none",
    "db:pull": "prisma db pull",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "build": "nest build && tsc-alias -v",
    "start:dev": "dotenvx run -f .env.development -- nest start --watch --exec \"pnpm tsc-alias -v && node dist/src/main\"",
    "start:prod": "pnpm build && dotenvx run -f .env.production -- node dist/src/main",
    "test": "dotenvx run -f .env.test -- jest",
    "test:watch": "dotenvx run -f .env.test -- jest --watch",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "lint:staged": "lint-staged",
    "env:encrypt": "dotenvx encrypt -f .env.development .env.test .env.production",
    "env:decrypt": "dotenvx decrypt -f .env.development .env.test .env.production",
    "docs:gen-reference": "tsx scripts/generate-error-reference.ts",
    "docs:gen-openapi": "dotenvx run -f .env.development -- tsx scripts/generate-openapi.ts",
    "docs:dev": "pnpm docs:gen-reference && dotenvx run -f .env.development -- pnpm --filter biological-storage-box-docs dev",
    "docs:build": "pnpm docs:gen-reference && pnpm --filter biological-storage-box-docs build",
    "docs:serve": "pnpm --filter biological-storage-box-docs serve"
  },
  "dependencies": {
    "@dotenvx/dotenvx-ops": "^0.37.8",
    "@nestjs/common": "^11.1.19",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.19",
    "@nestjs/platform-express": "^11.1.19",
    "@nestjs/swagger": "^11.2.7",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@scalar/nestjs-api-reference": "^1.1.7",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "figlet": "^1.11.0",
    "gradient-string": "^3.0.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.18.1",
    "nestjs-pino": "^4.6.1",
    "nestjs-zod": "^5.3.0",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ulid": "^3.0.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.19",
    "@nestjs/testing": "^11.1.19",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.24",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "jest": "^30.3.0",
    "prisma": "^7.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
