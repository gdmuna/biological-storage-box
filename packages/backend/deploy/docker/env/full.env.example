# Copy this file to env/full.env and replace every blank value before starting
# compose.full.yaml. Keep the real file out of version control.

POSTGRES_USER=talosark
# Use only URI-safe characters: A-Z, a-z, 0-9, ., _, ~, and -.
# The value is embedded in the backend URL and Casdoor's PostgreSQL DSN.
POSTGRES_PASSWORD=
POSTGRES_DB=talosark
POSTGRES_SHADOW_DB=talosark_shadow
CASDOOR_DB=casdoor

# RustFS access keys must not contain '/'.
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=

# Set this to the externally visible HTTPS URL in a real deployment.
CASDOOR_ORIGIN=http://localhost:8000

NODE_ENV=production
BACKEND_PORT=3000
CASDOOR_PORT=8000
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001

S3_REGION=us-east-1
S3_BUCKET_PUBLIC=talos-ark-public
S3_BUCKET_PRIVATE=talos-ark-private
S3_BUCKET_STAGING=talos-ark-staging
S3_PUBLIC_BASE_URL=http://localhost:9000
