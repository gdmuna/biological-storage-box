generator client {
  provider     = "prisma-client"
  output       = "./generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(ulid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  nickname     String?
  realname     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedOrgs      Organization[]     @relation("OrgOwner")
  orgMemberships OrganizationUser[]
  nodeLogs       NodeLog[]
  reagentLogs    ReagentLog[]
  feedbacks      Feedback[]

  @@index(createdAt)
}

model Organization {
  id          String   @id @default(ulid())
  name        String
  description String?
  ownerId     String
  isPublic    Boolean  @default(false)
  avatarUrl   String?
  settings    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner          User               @relation("OrgOwner", fields: [ownerId], references: [id])
  members        OrganizationUser[]
  nodes          Node[]
  ownedShares    ResourceShare[]    @relation("OwnedShares")
  receivedShares ResourceShare[]    @relation("ReceivedShares")
  reagents       Reagent[]
  reagentTypes   ReagentType[]

  @@index([ownerId])
}

model OrganizationUser {
  id        String        @id @default(ulid())
  orgId     String
  userId    String
  role      OrgRole       @default(MEMBER)
  status    OrgUserStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

enum OrgUserStatus {
  PENDING
  ACTIVE
  REJECTED
}

enum NodeType {
  ROOT
  CONTAINER
  BOX
  BOX_SLOT
}

model Node {
  id          String   @id @default(ulid())
  orgId       String
  parentId    String?
  name        String
  description String?
  type        NodeType
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org        Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  parent     Node?           @relation("NodeTree", fields: [parentId], references: [id], onDelete: SetNull)
  children   Node[]          @relation("NodeTree")
  // aliases    NodeAlias[]
  images     NodeImage[]
  NodeLogs   NodeLog[]
  gridConfig NodeGridConfig?
  reagents   Reagent[]

  @@index([orgId])
  @@index([parentId])
  @@index([orgId, parentId])
}

