generator client {
  provider     = "prisma-client"
  output       = "./generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(ulid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  nickname     String?
  realname     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedOrgs      Organization[]     @relation("OrgOwner")
  orgMemberships OrganizationUser[]
  boxLogs        BoxLog[]
  feedbacks      Feedback[]

  @@index(createdAt)
}

model Organization {
  id          String   @id @default(ulid())
  name        String
  description String?
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner   User               @relation("OrgOwner", fields: [ownerId], references: [id])
  members OrganizationUser[]
  roots   Root[]
  nodes   Node[]
  boxes   Box[]

  @@index([ownerId])
}

model OrganizationUser {
  id        String        @id @default(ulid())
  orgId     String
  userId    String
  role      OrgRole       @default(MEMBER)
  status    OrgUserStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

enum OrgUserStatus {
  PENDING
  ACTIVE
  REJECTED
}

model Node {
  id          String    @id @default(ulid())
  orgId       String
  parentId    String?
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  parent   Node?        @relation("NodeTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Node[]       @relation("NodeTree")
  boxes    Box[]        @relation("BoxNode")

  @@index([orgId])
  @@index([parentId])
}

model Root {
  id          String   @id @default(ulid())
  orgId       String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  boxes Box[]

  @@index([orgId])
}

model Box {
  id          String   @id @default(ulid())
  orgId       String
  rootId      String?
  nodeId      String?
  name        String
  description String?
  rows        Int      @default(9)
  cols        Int      @default(9)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  root     Root?        @relation(fields: [rootId], references: [id], onDelete: SetNull)
  node     Node?        @relation("BoxNode", fields: [nodeId], references: [id], onDelete: SetNull)
  aliases  BoxAlias[]
  images   BoxImage[]
  logs     BoxLog[]
  reagents Reagent[]

  @@index([orgId])
  @@index([rootId])
  @@index([nodeId])
}

model BoxAlias {
  id        String   @id @default(ulid())
  boxId     String
  alias     String
  createdAt DateTime @default(now())

  box Box @relation(fields: [boxId], references: [id], onDelete: Cascade)

  @@index([boxId])
}

model BoxImage {
  id        String   @id @default(ulid())
  boxId     String
  imageUrl  String
  createdAt DateTime @default(now())

  box Box @relation(fields: [boxId], references: [id], onDelete: Cascade)

  @@index([boxId])
}

model BoxLog {
  id            String   @id @default(ulid())
  boxId         String
  userId        String
  reagentId     String?
  operationType String
  detail        String?
  createdAt     DateTime @default(now())

  box     Box      @relation(fields: [boxId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id])
  reagent Reagent? @relation(fields: [reagentId], references: [id], onDelete: SetNull)

  @@index([boxId])
  @@index([userId])
  @@index([reagentId])
}

model Reagent {
  id          String   @id @default(ulid())
  boxId       String
  orgId       String
  position    String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  box  Box      @relation(fields: [boxId], references: [id], onDelete: Cascade)
  logs BoxLog[]

  @@index([boxId])
  @@index([orgId])
}

model Feedback {
  id        String   @id @default(ulid())
  userId    String
  content   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model EmailVerification {
  id        String   @id @default(ulid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}
